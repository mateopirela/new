---
import Base from '../layouts/Base.astro';
import { getStores, getReportDate, getRegionName } from '../lib/stores';
import { config } from '../lib/config';

const stores = getStores();
const date = getReportDate();
const region = getRegionName();
---
<Base title={`Tiendas en tendencia — ${region}`} description={`Tiendas de dropshipping generadas a partir de las búsquedas en tendencia en ${region}.`}>
  <header class="site-header">
    <div class="container">
      <a class="brand" href={config.base}>🛍️ Tiendas en tendencia <small>{region}</small></a>
    </div>
  </header>

  <section class="hero">
    <div class="container">
      <span class="badge">Actualizado {date} · {region}</span>
      <h1>Tiendas creadas a partir de lo que la gente busca hoy</h1>
      <p>Cada tienda nace de una oportunidad real detectada en Google Trends. Elige una para ver su catálogo.</p>
    </div>
  </section>

  <main class="container">
    {stores.length === 0 && (
      <p style="padding:40px 0">Hoy no se detectaron oportunidades con suficiente potencial de producto.</p>
    )}
    <h2 class="section-title">{stores.length} tiendas generadas</h2>
    <p class="section-sub">Ordenadas por potencial de dropshipping estimado.</p>
    <div class="grid">
      {stores.map((s) => (
        <article class="card store-card">
          <a class="thumb" href={`./${s.slug}/`}>
            <img src={s.products[0]?.image} alt={s.name} width="600" height="600" />
          </a>
          <div class="body">
            <h3><a href={`./${s.slug}/`}>{s.meta.emoji} {s.name}</a></h3>
            <div class="meta">
              <span class="pill">{s.categoryLabel}</span>
              <span class="score">⚡ {s.score}/100</span>
            </div>
            <p class="section-sub" style="margin:4px 0 0; font-size:0.85rem">{s.products.length} productos · {s.approxTraffic || 's/d'} búsquedas</p>
            <a class="btn btn-outline" href={`./${s.slug}/`}>Ver tienda →</a>
          </div>
        </article>
      ))}
    </div>
  </main>

  <footer class="site-footer">
    <div class="container">
      <p>Directorio generado automáticamente · datos de Google Trends ({date}).</p>
    </div>
  </footer>
</Base>
