---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getStores, getReportDate } from '../../lib/stores';
import { whatsappLink } from '../../lib/format';

export function getStaticPaths() {
  const paths = [];
  for (const store of getStores()) {
    for (const product of store.products) {
      paths.push({ params: { store: store.slug, product: product.slug }, props: { store, product } });
    }
  }
  return paths;
}

const { store, product } = Astro.props;
const date = getReportDate();
const wa = whatsappLink(store.name, product.name, product.priceLabel);
---
<Base title={`${product.name} — ${store.name}`} description={product.description} brand={store.meta.color} accent={store.meta.accent}>
  <Header name={store.name} emoji={store.meta.emoji} cta={wa} home="../" />

  <div class="container">
    <p class="crumbs"><a href="../">← {store.name}</a> / {product.name}</p>
    <div class="product">
      <div class="gallery">
        <img src={product.image} alt={product.name} width="600" height="600" />
      </div>
      <div class="info">
        <h1>{product.name}</h1>
        <div class="price-row">
          <span class="price">{product.priceLabel}</span>
          <span class="compare">{product.compareAtLabel}</span>
          <span class="discount">-{product.discountPct}%</span>
        </div>
        <p class="desc">{product.description}</p>
        <ul>
          {store.meta.benefits.map((b) => <li>{b}</li>)}
        </ul>
        <div class="buy">
          <a class="btn btn-wa" href={wa} target="_blank" rel="noopener">💬 Pedir por WhatsApp</a>
        </div>
      </div>
    </div>
  </div>

  <Footer name={store.name} date={date} />
</Base>
