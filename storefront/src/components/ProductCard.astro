---
import type { Product, Store } from '../lib/stores';
import { whatsappLink } from '../lib/format';
export interface Props { product: Product; store: Store; }
const { product, store } = Astro.props;
const wa = whatsappLink(store.name, product.name, product.priceLabel);
---
<article class="card">
  <a class="thumb" href={`./${product.slug}/`}>
    <img src={product.image} alt={product.name} loading="lazy" width="600" height="600" />
  </a>
  <div class="body">
    <h3><a href={`./${product.slug}/`}>{product.name}</a></h3>
    <div class="price-row">
      <span class="price">{product.priceLabel}</span>
      <span class="compare">{product.compareAtLabel}</span>
      <span class="discount">-{product.discountPct}%</span>
    </div>
    <a class="btn btn-wa" href={wa} target="_blank" rel="noopener">💬 Pedir por WhatsApp</a>
  </div>
</article>
