---
export interface Props { name: string; date?: string; }
const { name, date } = Astro.props;
const year = date ? date.slice(0, 4) : '2026';
---
<footer class="site-footer">
  <div class="container">
    <p>
      © {year} {name}. Tienda generada automáticamente a partir de tendencias de
      búsqueda. Productos sujetos a disponibilidad de proveedor.
    </p>
    <p>Pedidos y atención por WhatsApp. Pago contra entrega disponible.</p>
  </div>
</footer>
