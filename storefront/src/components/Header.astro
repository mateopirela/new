---
export interface Props { name: string; emoji?: string; cta?: string; home?: string; }
const { name, emoji = '🛍️', cta, home = './' } = Astro.props;
---
<header class="site-header">
  <div class="container">
    <a class="brand" href={home}>
      <span>{emoji} {name}</span>
    </a>
    {cta && (
      <a class="header-cta" href={cta} target="_blank" rel="noopener">
        💬 Pedir por WhatsApp
      </a>
    )}
  </div>
</header>
